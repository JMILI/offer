# offer — 环境变量样例（复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交）
# 数据库（MySQL）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/offer

# 本地 HTTP 服务
HOST=127.0.0.1
PORT=4000
OPEN_BROWSER=false
RUST_LOG=info

# SMTP 发信（QQ 邮箱请填「授权码」而不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM=your_account@qq.com

# 测试邮件固定收件人（代码有默认值，可按需覆盖）
# TEST_EMAIL_TO=you@example.com
